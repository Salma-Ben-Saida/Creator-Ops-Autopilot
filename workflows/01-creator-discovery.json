                "operation": "gte"
              }
            },
            {
              "id": "eee32439-4966-4cec-bb40-f2b980fed5ba",
              "leftValue": "={{ $json.statistics.subscriberCount }}",
              "rightValue": 1000000,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            },
            {
              "id": "e06a4555-950a-4187-8444-7451ffe11c8d",
              "leftValue": "={{ $json.statistics.videoCount }}",
              "rightValue": 20,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
