      ],
      "id": "399cfd1b-29f3-4b5b-a590-8410f12200dc",
      "name": "Filter"
    },
    {
      "parameters": {
        "jsCode": "const c = $json;\nconst keyword = $('Prep IDs').item.json.keyword.toLowerCase();\n\nconst subs   = Number(c.statistics.subscriberCount);\nconst views  = Number(c.statistics.viewCount);\nconst videos = Number(c.statistics.videoCount);\nconst text   = `${c.snippet.title} ${c.snippet.description || ''}`.toLowerCase();\n\n// engagement proxy: average views per video relative to subscribers\nconst avgViews  = views / Math.max(videos, 1);\nconst viewRatio = Math.min(avgViews / subs, 1);\n\n// keyword relevance: share of keyword words found in title/description\nconst words = keyword.split(' ').filter(w => w.length > 2);\nconst hits  = words.filter(w => text.includes(w)).length;\nconst keywordFit = words.length ? hits / words.length : 0;\n\nconst sizeFit = (subs >= 25000 && subs <= 250000) ? 1 : 0.5;\n\nconst score = viewRatio * 50 + keywordFit * 30 + sizeFit * 20;\n\nreturn { json: {\n  channel_id: c.id,\n  channel_title: c.snippet.title,\n  channel_url: `https://youtube.com/channel/${c.id}`,\n  country: c.snippet.country || null,\n  subscribers: subs,\n  total_views: views,\n  video_count: videos,\n  matched_keyword: keyword,\n  score: Number(score.toFixed(2)),\n  contact_email: `creator+${c.id.slice(-8).toLowerCase()}@example.com`  // fake on purpose\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "id": "86780c60-f8c9-4ed1-a14f-3042e073440a",
      "name": "Score"
    },
